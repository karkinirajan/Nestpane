{
  "name": "novatab",
  "version": "1.3.0",
  "description": "A beautiful productivity new tab Chrome extension",
  "private": true,
  "scripts": {
    "build": "node build.js",
    "dev": "node build.js --watch",
    "lint": "npx eslint app.js --no-eslintrc --rule '{\"no-unused-vars\":\"warn\",\"no-undef\":\"warn\"}'",
    "zip": "node build.js && cd dist && zip -r ../novatab-v$(node -p \"require('../package.json').version\")-chrome.zip ."
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}

{
  "manifest_version": 3,
  "name": "Nestpane",
  "version": "1.6.1",
  "description": "Replaces the new tab with a local-first dashboard: workspaces, bookmarks, notes, tasks, focus timer, optional Drive sync.",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "incognito": "split",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/favicon.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/favicon.png"
  },
  "oauth2": {
    "client_id": "692567523727-k7vrtsqsdra1dhml1jdtjpos1q0j1p27.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/userinfo.email",
      "https://www.googleapis.com/auth/userinfo.profile",
      "https://www.googleapis.com/auth/drive.appdata"
    ]
  },
  "permissions": [
    "tabs",
    "bookmarks",
    "history",
    "downloads",
    "storage",
    "topSites",
    "declarativeNetRequest",
    "search"
  ],
  "optional_permissions": [
    "identity",
    "identity.email",
    "geolocation",
    "notifications"
  ],
  "host_permissions": [
    "https://wttr.in/*",
    "https://fonts.googleapis.com/*",
    "https://fonts.gstatic.com/*",
    "https://www.googleapis.com/*",
    "https://www.googleapis.com/upload/drive/v3/*",
    "https://oauth2.googleapis.com/*",
    "https://ipwho.is/*",
    "https://nominatim.openstreetmap.org/*",
    "https://picsum.photos/*",
    "https://api.anthropic.com/*"
  ]
}
{
  "manifest_version": 3,
  "name": "novatab",
  "version": "1.1.0",
  "description": "A beautiful productivity new tab page with workspaces, bookmarks, notes, tasks, focus timer, and cloud sync.",
  "chrome_url_overrides": { "newtab": "newtab.html" },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon-16.png",
      "48": "icon-48.png",
      "128": "favicon.png"
    }
  },
  "icons": {
    "16": "icon-16.png",
    "48": "icon-48.png",
    "128": "favicon.png"
  },
  "oauth2": {
    "client_id": "1068722184119-5oo9t1q96u9r6ccb3gd02nm6jbp9ekq1.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/userinfo.email",
      "https://www.googleapis.com/auth/userinfo.profile",
      "https://www.googleapis.com/auth/drive.appdata"
    ]
  },
  "permissions": [
    "tabs",
    "bookmarks",
    "history",
    "downloads",
    "storage",
    "topSites",
    "identity",
    "identity.email",
    "geolocation"
  ],
  "host_permissions": [
    "https://wttr.in/*",
    "https://fonts.googleapis.com/*",
    "https://fonts.gstatic.com/*",
    "https://www.googleapis.com/*",
    "https://www.googleapis.com/upload/drive/v3/*",
    "https://oauth2.googleapis.com/*",
    "https://motivational-spark-api.vercel.app/*",
    "https://ipwho.is/*",
    "https://nominatim.openstreetmap.org/*",
    "https://source.unsplash.com/*",
    "https://picsum.photos/*"
  ]
}

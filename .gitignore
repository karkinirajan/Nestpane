# Build output — contents are copied here by build.js and then zipped
dist/

# Versioned release directories (generated by build + unzip workflow)
novatab-v*-chrome/

# Packaged extension ZIPs (generated by: cd dist && zip -r ../*.zip .)
*.zip

# Node
node_modules/
npm-debug.log*
yarn.lock
package-lock.json

# Environment variables (never commit secrets)
.env
.env.*

# Logs
*.log

# OS
.DS_Store
Thumbs.db
desktop.ini

# Editor
.vscode/
.idea/
*.swp
*.swo
*.orig

# Claude Code configuration
.claude/

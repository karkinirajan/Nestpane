# Build output — contents are copied here by build.js and then zipped
dist/

# Packaged extension ZIPs (generated by: cd dist && zip -r ../*.zip .)
*.zip

# Extension signing key and packaged .crx — never commit private keys
*.pem
*.crx

# Node
node_modules/
npm-debug.log*

# Git worktrees (checked out working copies, not tracked content)
.claude/worktrees/

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp
*.swo
